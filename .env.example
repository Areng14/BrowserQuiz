# Copy to .env and fill these in. Make each secret long and random, for example:
#   openssl rand -base64 24
# No openssl (Windows)? In PowerShell:
#   [Convert]::ToBase64String((1..24 | % { [byte](Get-Random -Max 256) }))

# Teacher dashboard password (at /teacher).
ADMIN_PASSWORD=

# Secret mixed into student ID hashes. Set it once and never change it, or rosters stop matching.
ID_PEPPER=

# Shared secret between the app and the code runner (16+ characters).
RUNNER_TOKEN=

# --- HTTPS (recommended for real classes) ---
# Your domain, pointed at this machine. Then run: docker compose --profile https up -d --build
# DOMAIN=quiz.example.com
# With Caddy in front, only Caddy should reach the app, and the app should trust it for client IPs:
# APP_BIND=127.0.0.1
# TRUST_PROXY=1

# --- Optional tuning ---
# APP_PORT=8080
# RUNNER_SLOTS=4
# RUNNER_MEMORY=2g
# RUNNER_CPUS=2
