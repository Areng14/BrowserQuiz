# Copy to .env and fill these in. Make each secret long and random, for example:
#   openssl rand -base64 24
# No openssl (Windows)? In PowerShell:
#   [Convert]::ToBase64String((1..24 | % { [byte](Get-Random -Max 256) }))

# Admin's password for the teacher dashboard (at /teacher), or leave it empty: then the server log
# shows a one-time code to sign in as admin, and admin picks their own password (and gets a recovery
# code, so admin's quizzes are private from whoever runs the server too). See them with:
#   docker compose logs app
ADMIN_PASSWORD=

# Admin forgot their own password? Set this to any new word and restart: the log shows a new one-time
# code, once. (Their recovery code keeps their quizzes.)
# ADMIN_RESET=

# Secret mixed into student ID hashes. Set it once and never change it, or rosters stop matching.
ID_PEPPER=

# Shared secret between the app and the code runner (16+ characters).
RUNNER_TOKEN=

# --- HTTPS (recommended for real classes) ---
# Your domain, pointed at this machine. Then run: docker compose --profile https up -d --build
# DOMAIN=quiz.example.com
# With Caddy in front, only Caddy should reach the app, and the app should trust it for client IPs:
# APP_BIND=127.0.0.1
# TRUST_PROXY=1

# --- Optional: AI grading with Claude (see docs/setup.md) ---
# ANTHROPIC_API_KEY=
# AI_GRADER_MODEL=claude-opus-5-5

# --- Optional tuning ---
# APP_PORT=8080
# RUNNER_SLOTS=4
# RUNNER_MEMORY=2g
# RUNNER_CPUS=2
