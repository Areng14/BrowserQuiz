# Copy to .env and fill these in. Make each secret long and random, for example:
#   openssl rand -base64 24
# No openssl (Windows)? In PowerShell:
#   [Convert]::ToBase64String((1..24 | % { [byte](Get-Random -Max 256) }))

# Admin's first password for the teacher dashboard (at /teacher), with the username admin. Signing in
# with it, admin picks their own username and password (the password can be the same) and gets a
# recovery code, so admin's quizzes and students are private from whoever runs the server too; after
# that this isn't used. Or leave it empty: then the server log shows a one-time code to sign in with
# instead. See it with:
#   docker compose logs app
ADMIN_PASSWORD=

# Admin forgot their own password? Set this to any new word and restart: the log shows a new one-time
# code, once. (Their recovery code keeps their quizzes.)
# ADMIN_RESET=

# Secret mixed into student ID hashes. Set it once and never change it, or rosters stop matching.
ID_PEPPER=

# Shared secret between the app and the code runner (16+ characters).
RUNNER_TOKEN=

# --- HTTPS (recommended for real classes) ---
# Your domain, pointed at this machine. Then run: docker compose --profile https up -d --build
# DOMAIN=quiz.example.com
# With Caddy in front, only Caddy should reach the app, and the app should trust it for client IPs:
# APP_BIND=127.0.0.1
# TRUST_PROXY=1

# --- Optional: one AI grading key for every teacher (see docs/setup.md) ---
# Set one. Teachers can also add their own key in Grade with AI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Models: Claude defaults to claude-opus-5-5; OpenAI and Gemini to the newest one the key can use.
# AI_GRADER_MODEL=
# OPENAI_GRADER_MODEL=
# GEMINI_GRADER_MODEL=

# --- Optional tuning ---
# APP_PORT=8080
# RUNNER_SLOTS=4
# RUNNER_MEMORY=2g
# RUNNER_CPUS=2

# --- Where students join ---
# The live page shows it: this computer's network address when you use the dashboard at localhost
# (the setup script finds it). Set it here if that's wrong, say with two networks.
# STUDENT_URL=http://192.168.1.20:8080
