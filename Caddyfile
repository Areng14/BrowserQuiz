{$DOMAIN} {
	encode gzip
	reverse_proxy app:8080

	# While the app is down (restarting after an update or a restore), a page in its look instead of a blank
	# one. Its own copy of the styles: the app's aren't there to load. (public/error.html is the app's.)
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control no-store
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Can't reach BrowserQuiz</title>
			<style>
			:root { --bg: #fff; --ink: #16191d; --num: #868e99; --accent: #2257d6; --on: #fff; }
			@media (prefers-color-scheme: dark) { :root { --bg: #16181d; --ink: #e6e8eb; --num: #6b7480; --accent: #7ea3ff; --on: #16181d; } }
			html, body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
			main { display: flex; justify-content: center; padding: max(96px, 16vh) 16px 48px; }
			div { width: min(100%, 420px); display: grid; gap: 16px; }
			p { margin: 0; font-size: clamp(88px, 18vw, 128px); font-weight: 800; line-height: 0.9; letter-spacing: -0.04em; margin-left: -0.03em; color: var(--num); }
			h1 { margin: 0; font-size: 28px; line-height: 1.2; letter-spacing: -0.01em; }
			a { justify-self: start; display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: 6px; background: var(--accent); color: var(--on); font-weight: 600; text-decoration: none; }
			a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			</style>
			</head>
			<body><main><div><p>{err.status_code}</p><h1>The server isn't answering</h1><a href="">Try again</a></div></main></body>
			</html>
			HTML {err.status_code}
	}
}
